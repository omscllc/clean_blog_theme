<?php

/**
 * @file
 * Functions to support theming in the theme.
 */

use \Drupal\Core\Form\FormStateInterface;

$theme_name = \Drupal::theme()->getActiveTheme()->getName();
define('THEME_PATH', base_path() . \Drupal::service('extension.list.theme')->getPath($theme_name));

use Drupal\Component\Utility\SafeMarkup;
use Drupal\Component\Utility\Xss;
use Drupal\Core\Template\Attribute;
use Drupal\file\Entity\File;
use Drupal\file\Plugin\Core\Entity\FileInterface;

/**
 * Override or insert variables into the page template.
 */
function clean_blog_theme_preprocess_page(&$vars) {

    // Add information about the number of sidebars.
    if (!empty($vars['page']['sidebar_first']) && !empty($vars['page']['sidebar_second'])) {
        $vars['conditionalStr'] = 'col-md-6 col-sm-6';
        $vars['sidebarfirst'] = 'col-md-3 col-sm-3';
        $vars['sidebarsecond'] = 'col-md-3 col-sm-3';
    } elseif (!empty($vars['page']['sidebar_first'])) {
        $vars['conditionalStr'] = 'col-md-8 col-sm-8 ';
        $vars['sidebarfirst'] = 'col-md-4 col-sm-4';
    } elseif (!empty($vars['page']['sidebar_second'])) {
        $vars['conditionalStr'] = 'col-md-8 sol-sm-8 ';
        $vars['sidebarsecond'] = 'col-md-4 col-sm-4';
    } else {
        $vars['conditionalStr'] = 'col-lg-12  centered ';
    }
    // Slide show
    $show_slideshow = theme_get_setting('slideshow_display');
    $slide_count = (int) theme_get_setting('slide_count');
    $slide_count = max(1, min(10, $slide_count));
    if ($vars['is_front'] && $show_slideshow) {
        $vars['slider'] = array();
        for ($i = 1; $i <= $slide_count; $i++) {
            $fid = theme_get_setting("slide_image_{$i}");
            if (!empty($fid)) {
                $file = File::load($fid[0]);
                $uri = $file->getFileUri();
                $image_path = \Drupal::service('file_url_generator')->generateAbsoluteString($uri);
            } else {
                $image_path = THEME_PATH . "/images/slider_img{$i}.jpg";
            }
            $vars['slider'][] = array(
                'url' => theme_get_setting("slide_url_{$i}"),
                'src' => $image_path,
                'title' => theme_get_setting("slide_title_{$i}"),
            );
        }
    }
}

/**
 * Implements hook_form_FORM_ID_alter().
 *
 * @param $form
 *   The form.
 * @param $form_state
 *   The form state.
 */
function clean_blog_theme_form_system_theme_settings_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {

    $form['busi_settings']['slideshow'] = array(
        '#type' => 'details',
        '#title' => t('Front Page Slideshow'),
        '#collapsible' => TRUE,
        '#collapsed' => FALSE,
    );
    $form['busi_settings']['slideshow']['slideshow_display'] = array(
        '#type' => 'checkbox',
        '#title' => t('Show slideshow'),
        '#default_value' => theme_get_setting('slideshow_display'),
        '#description' => t("Check this option to show Slideshow in front page. Uncheck to hide."),
    );
    $form['busi_settings']['slideshow']['slide_count'] = array(
        '#type' => 'select',
        '#title' => t('Number of slides'),
        '#options' => array_combine(range(1, 10), range(1, 10)),
        '#default_value' => theme_get_setting('slide_count'),
        '#description' => t('Select the number of slides to display (1-10).'),
        '#states' => array(
            'enabled' => array(
                ':input[name="slideshow_display"]' => array('checked' => TRUE),
            ),
        ),
        '#ajax' => array(
            'callback' => 'clean_blog_theme_slide_count_callback',
            'wrapper' => 'slide-fieldsets-wrapper',
            'event' => 'change',
        ),
    );
    $form['busi_settings']['slideshow']['slide'] = array(
        '#markup' => t('You can change the title, url and image of each slide in the following Slide Setting fieldsets.'),
    );
    $form['busi_settings']['slideshow']['slide_fieldsets'] = array(
        '#type' => 'container',
        '#attributes' => array('id' => 'slide-fieldsets-wrapper'),
    );
    $slide_count = (int) $form_state->getValue('slide_count', theme_get_setting('slide_count'));
    $slide_count = max(1, min(10, $slide_count));
    for ($i = 1; $i <= $slide_count; $i++) {
        $form['busi_settings']['slideshow']['slide_fieldsets']['slide' . $i] = array(
            '#type' => 'details',
            '#title' => t('Slide ' . $i),
            '#collapsible' => TRUE,
            '#collapsed' => TRUE,
        );
        $form['busi_settings']['slideshow']['slide_fieldsets']['slide' . $i]['slide_title_' . $i] = array(
            '#type' => 'textfield',
            '#title' => t('Slide ' . $i . ' Title'),
            '#default_value' => theme_get_setting("slide_title_{$i}"),
        );
        $form['busi_settings']['slideshow']['slide_fieldsets']['slide' . $i]['slide_image_' . $i] = array(
            '#type' => 'managed_file',
            '#title' => t('Slide ' . $i . ' Image'),
            '#description' => t('Use same size for all the slideshow images(Recommented size : 1920 X 603).'),
            '#default_value' => theme_get_setting("slide_image_{$i}"),
            '#upload_location' => 'public://',
        );
        $form['busi_settings']['slideshow']['slide_fieldsets']['slide' . $i]['slide_url_' . $i] = array(
            '#type' => 'textfield',
            '#title' => t('Slide ' . $i . ' URL'),
            '#default_value' => theme_get_setting("slide_url_{$i}"),
        );
    }

    // FontAwesome CDN toggle.
    $form['busi_settings']['fontawesome'] = [
        '#type' => 'details',
        '#title' => t('FontAwesome CDN'),
        '#collapsible' => TRUE,
        '#collapsed' => TRUE,
    ];
    $form['busi_settings']['fontawesome']['include_fontawesome'] = [
        '#type' => 'checkbox',
        '#title' => t('Include FontAwesome icons (CDN)'),
        '#default_value' => theme_get_setting('include_fontawesome'),
        '#description' => t('Check to include FontAwesome icons from CDN. Uncheck to disable.'),
    ];

    // Custom submit to save the file permenant.
    $form['#submit'][] = 'clean_blog_theme_settings_form_submit';
}

/**
 * Custom submit handler for integrity settings form.
 */
function clean_blog_theme_settings_form_submit(&$form, \Drupal\Core\Form\FormStateInterface $form_state) {

    $account = \Drupal::currentUser();
    $values = $form_state->getValues();
    $slideshow_count = (int) $values['slide_count'];
    for ($i = 0; $i <= $slideshow_count; $i++) {
        if (isset($values["slide_image_{$i}"]) && !empty($values["slide_image_{$i}"])) {
            if ($values) {
                // Load the file via file.fid.
                $file = File::load($values["slide_image_{$i}"][0]);
                // Change status to permanent.
                $file->setPermanent();
                $file->save();
                $file_usage = \Drupal::service('file.usage');
                $file_usage->add($file, 'user', 'user', $account->id());
            }
        }
    }
}

/**
 * Implements hook_preprocess_html().
 */
function clean_blog_theme_preprocess_html(&$variables) {
  if (theme_get_setting('include_fontawesome')) {
    \Drupal::service('library.discovery')->getLibraryByName('clean_blog_theme', 'fontawesome-cdn');
    $variables['#attached']['library'][] = 'clean_blog_theme/fontawesome-cdn';
  }
  if (theme_get_setting('slideshow_display')) {
    \Drupal::service('library.discovery')->getLibraryByName('clean_blog_theme', 'flexslider-cdn');
    $variables['#attached']['library'][] = 'clean_blog_theme/flexslider-cdn';
  }
}

/**
 * AJAX callback to update slide fieldsets based on slide count.
 */
function clean_blog_theme_slide_count_callback($form, FormStateInterface $form_state) {
    return $form['busi_settings']['slideshow']['slide_fieldsets'];
}